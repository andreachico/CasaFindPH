# CasaFind backend environment configuration
#
# The CasaFind website reads the SAME data that editors publish in CasaFindCMS.
# Point DATABASE_URL at the CasaFindCMS Supabase Postgres database so the
# `properties` table is shared between the CMS and the public website.
#
# Supabase project ref: aqjcenbpbdhgsgcnacin
# Find the exact connection string in the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> URI
#
# Direct connection (IPv6/allowed networks):
#   postgresql://postgres:<YOUR-DB-PASSWORD>@db.aqjcenbpbdhgsgcnacin.supabase.co:5432/postgres
#
# Connection pooler (recommended for most hosts, replace <region>):
#   postgresql://postgres.aqjcenbpbdhgsgcnacin:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:<YOUR-DB-PASSWORD>@db.aqjcenbpbdhgsgcnacin.supabase.co:5432/postgres

# Secret used to sign login/register JWTs. Use a long random value in production.
JWT_SECRET=change-me
